{
  "manifest_version": 3,
  "name": "GASコンボ ブラウザ連動",
  "version": "1.3.1",
  "description": "GASコンボ：拡張のアイコン（または Alt+G）で、ブラウザの右のサイドパネルに GASコンボを開く（今開いているスプレッドシートが相手）。選択セル範囲などを GASコンボの操作窓（Python）へも知らせる。",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.googleusercontent.com/*",
    "https://docs.google.com/document/*",
    "https://docs.google.com/spreadsheets/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/*",
        "https://docs.google.com/document/d/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GASコンボをサイドパネルに開く（Alt+G）"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "GASコンボをサイドパネルに開く"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
