{
  "manifest_version": 3,
  "name": "GASコンボ ブラウザ連動",
  "version": "1.1.0",
  "description": "GASコンボ：拡張のアイコン（または Alt+G）で、今開いているスプレッドシートの操作窓を直接開く。選択セル範囲などを GASコンボの操作窓（Python）へも知らせる。",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://docs.google.com/spreadsheets/*",
    "https://docs.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/*",
        "https://docs.google.com/document/d/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GASコンボの操作窓を開く（Alt+G）"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "GASコンボの操作窓を開く"
    }
  }
}
